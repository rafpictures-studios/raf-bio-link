# Copy these into Vercel: Project > Settings > Environment Variables.
# Never commit real values to GitHub.

# Gmail address that sends the notifications (the account that owns the App Password)
GMAIL_USER=alfajririzqi@gmail.com

# 16-character Google App Password (spaces are fine, they are removed)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: where notifications go. Defaults to GMAIL_USER.
MAIL_TO=

# Optional: only accept form posts from this site, e.g. https://raf-bio.vercel.app
# Leave empty to accept any origin.
ALLOWED_ORIGIN=
